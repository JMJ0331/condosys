# Django Settings
SECRET_KEY=django-insecure-change-me-in-production-CONDOSYS-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database - SQLite para desarrollo (cambiar a PostgreSQL en producción)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# Supabase (opcional, usar solo si lo requieres)
SUPABASE_URL=
SUPABASE_KEY=

# Email (para notificaciones)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# WebSockets / Redis (para Django Channels)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery (para tareas asincrónicas)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
